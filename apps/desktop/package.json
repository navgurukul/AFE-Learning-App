{
    "name": "desktop",
    "type": "module",
    "version": "1.5.34",
    "private": true,
    "description": "Electron main process for Offline Learning App",
    "author": "NavGurukul <info@navgurukul.org>",
    "main": "./dist/main/index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/navgurukul/AFE-Learning-App"
    },
    "scripts": {
        "pc": "node ../../scripts/pc.js",
        "dev": "node ../../scripts/platform-runner.js dev",
        "dev:main": "tsc -b && node ../../scripts/copy-preload.js && electron .",
        "dev:renderer": "pnpm --filter renderer dev",
        "copy-preload": "node ../../scripts/copy-preload.js",
        "build": "tsc && node ../../scripts/copy-preload.js",
        "build:installer": "node ../../scripts/platform-runner.js build:installer",
        "build:installer:linux": "node ../../scripts/platform-runner.js build:installer --target=linux",
        "publish:installer": "node ../../scripts/platform-runner.js publish:installer",
        "publish:installer:linux": "node ../../scripts/platform-runner.js publish:installer --target=linux",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@afe/shared": "workspace:*",
        "@backend/ai-tutor": "workspace:*",
        "@backend/analytics": "workspace:*",
        "@backend/content-engine": "workspace:*",
        "@backend/db": "workspace:*",
        "@backend/stt-engine": "workspace:*",
        "@backend/tts-engine": "workspace:*",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "9.6.0",
        "bindings": "^1.5.0",
        "builder-util-runtime": "^9.7.0",
        "drizzle-orm": "^0.29.5",
        "electron-log": "^5.4.3",
        "electron-updater": "^6.8.9",
        "file-uri-to-path": "^2.0.0",
        "fs-extra": "^11.3.6",
        "js-yaml": "^5.2.1",
        "jsonfile": "^6.1.0",
        "lazy-val": "^1.0.5",
        "lodash.escaperegexp": "^4.1.2",
        "lodash.isequal": "^4.5.0",
        "node-record-lpcm16": "^1.0.1",
        "ollama": "^0.5.18",
        "semver": "^7.8.5",
        "tiny-typed-emitter": "^2.1.0",
        "universalify": "^2.0.1",
        "whatwg-fetch": "^3.6.20",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/node": "20",
        "concurrently": "^8.2.2",
        "cross-env": "^10.1.0",
        "electron": "^28.1.3",
        "electron-builder": "^24.9.1",
        "prebuild-install": "^7.1.3",
        "typescript": "^5.3.3"
    }
}